<Window x:Class="TyrlovInventoryCRM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewmodels="clr-namespace:TyrlovInventoryCRM.ViewModels"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="Мини-CRM Склад (Тырлов Р.В.)" Height="750" Width="1100" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}" FontFamily="Segoe UI"
        Icon="Assets/app_icon.ico">
    <Window.DataContext>
        <viewmodels:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левое меню -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBg}" CornerRadius="0,20,20,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Width" Value="220"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ElementName=MenuToggle, Path=IsChecked}" Value="True">
                            <Setter Property="Width" Value="65"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="15,30,0,40">
                    <ToggleButton x:Name="MenuToggle" Content="≡" Foreground="{DynamicResource SidebarText}" FontSize="22" Width="35" Height="35" Cursor="Hand" Background="Transparent" BorderThickness="0">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>

                    <TextBlock Text="CRM СКЛАД" Foreground="{DynamicResource SidebarText}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=MenuToggle, Path=IsChecked}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- Кнопки навигации -->
                <StackPanel Grid.Row="1">
                    <Button Command="{Binding SwitchToProductsCommand}" Background="Transparent" Foreground="{DynamicResource SidebarText}" BorderThickness="0" Height="45" Margin="10,5" HorizontalContentAlignment="Left" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📦" FontSize="16" Width="25" TextAlignment="Center"/>
                            <TextBlock Text="Товары" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=MenuToggle, Path=IsChecked}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding SwitchToDashboardCommand}" Background="Transparent" Foreground="{DynamicResource SidebarText}" BorderThickness="0" Height="45" Margin="10,5" HorizontalContentAlignment="Left" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" FontSize="16" Width="25" TextAlignment="Center"/>
                            <TextBlock Text="Дашборд" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=MenuToggle, Path=IsChecked}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Основной контент -->
        <Grid Grid.Column="1" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Верхняя панель -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource CardBg}" CornerRadius="10" Height="45" Margin="0,0,30,0" Padding="15,0">
                    <Grid VerticalAlignment="Center">
                        <TextBlock Text="🔍 Поиск товаров..." Foreground="{DynamicResource MutedText}" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ToggleThemeCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" Height="26" Margin="0,0,15,0" Width="26">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent">
                                    <Path Fill="{DynamicResource PrimaryText}" Margin="2" Stretch="Uniform" x:Name="ThemeIcon"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsDarkTheme}" Value="False">
                                        <Setter Property="Data" TargetName="ThemeIcon" Value="M9.37,5.51C5.21,5.62,1.86,9.15,1.86,13.46c0,4.37,3.54,7.91,7.91,7.91c3.08,0,5.75-1.76,7.09-4.32C12.98,17.43,10,13.43,10,8.77C10,7.6,10.22,6.5,10.6,5.5C10.2,5.5,9.79,5.51,9.37,5.51z"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                        <Setter Property="Data" TargetName="ThemeIcon" Value="M12,7c-2.76,0-5,2.24-5,5s2.24,5,5,5s5-2.24,5-5S14.76,7,12,7z M2,13l2,0c0.55,0,1-0.45,1-1s-0.45-1-1-1l-2,0c-0.55,0-1,0.45-1,1S1.45,13,2,13z M20,13l2,0c0.55,0,1-0.45,1-1s-0.45-1-1-1l-2,0c-0.55,0-1,0.45-1,1S19.45,13,20,13z M11,2v2c0,0.55,0.45,1,1,1s1-0.45,1-1V2c0-0.55-0.45-1-1-1S11,1.45,11,2z M11,20v2c0,0.55,0.45,1,1,1s1-0.45,1-1v-2c0-0.55-0.45-1-1-1C11.45,19,11,19.45,11,20z M5.99,4.58c-0.39-0.39-1.03-0.39-1.41,0c-0.39,0.39-0.39,1.03,0,1.41l1.06,1.06c0.39,0.39,1.03,0.39,1.41,0s0.39-1.03,0-1.41L5.99,4.58z M18.36,16.95c-0.39-0.39-1.03-0.39-1.41,0c-0.39,0.39-0.39,1.03,0,1.41l1.06,1.06c0.39,0.39,1.03,0.39,1.41,0c0.39-0.39,0.39-1.03,0-1.41L18.36,16.95z M19.42,5.99c0.39-0.39,0.39-1.03,0-1.41c-0.39-0.39-1.03-0.39-1.41,0l-1.06,1.06c-0.39,0.39-0.39,1.03,0,1.41s1.03,0.39,1.41,0L19.42,5.99z M7.05,18.36c0.39-0.39,0.39-1.03,0-1.41c-0.39-0.39-1.03-0.39-1.41,0l-1.06,1.06c-0.39,0.39-0.39,1.03,0,1.41s1.03,0.39,1.41,0L7.05,18.36z"/>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" TargetName="ThemeIcon" Value="0.6"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <TextBlock Text="Привет, Ростик" VerticalAlignment="Center" Margin="0,0,15,0" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}"/>
                    <Border Width="40" Height="40" CornerRadius="20" Background="#D1D5DB"/>
                </StackPanel>
            </Grid>

            <!-- Экраны (Вкладки) -->
            <Grid Grid.Row="1">

                <!-- ЭКРАН 1: ТОВАРЫ (Скрывается при SelectedTab=1) -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTab}" Value="1">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Панель добавления -->
                    <Border Grid.Row="0" Background="{DynamicResource CardBg}" CornerRadius="10" Padding="20" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                <TextBlock Text="Название" Foreground="{DynamicResource MutedText}" FontSize="12" Margin="0,0,0,5"/>
                                <Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="6" Padding="8,4">
                                    <TextBox Text="{Binding NewProductName, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,15,0">
                                <TextBlock Text="Категория" Foreground="{DynamicResource MutedText}" FontSize="12" Margin="0,0,0,5"/>
                                <Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="6" Padding="8,4">
                                    <TextBox Text="{Binding NewProductCategory, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,15,0">
                                <TextBlock Text="Цена (₽)" Foreground="{DynamicResource MutedText}" FontSize="12" Margin="0,0,0,5"/>
                                <Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="6" Padding="8,4">
                                    <TextBox Text="{Binding NewProductPrice, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Margin="0,0,15,0">
                                <TextBlock Text="Остаток" Foreground="{DynamicResource MutedText}" FontSize="12" Margin="0,0,0,5"/>
                                <Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="6" Padding="8,4">
                                    <TextBox Text="{Binding NewProductQuantity, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}"/>
                                </Border>
                            </StackPanel>

                            <Button Grid.Column="4" Content="Добавить +" Command="{Binding AddProductCommand}" 
                                    Background="#5D78FF" Foreground="White" BorderThickness="0" Padding="20,0" Height="35" VerticalAlignment="Bottom" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Таблица и кнопки -->
                    <Border Grid.Row="1" Background="{DynamicResource CardBg}" CornerRadius="10" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DataGrid Grid.Row="0" ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" 
                                      AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single"
                                      Background="{DynamicResource CardBg}" BorderThickness="0" RowBackground="{DynamicResource CardBg}" AlternatingRowBackground="{DynamicResource RowAltBg}"
                                      Foreground="{DynamicResource PrimaryText}" GridLinesVisibility="None" HeadersVisibility="Column" RowHeight="45">

                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="{DynamicResource CardBg}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource MutedText}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Padding" Value="10,10,10,15"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="НАЗВАНИЕ" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="КАТЕГОРИЯ" Binding="{Binding Category}" Width="150"/>
                                    <DataGridTextColumn Header="ЦЕНА" Binding="{Binding Price, StringFormat={}{0:F2} ₽}" Width="120"/>
                                    <DataGridTextColumn Header="ОСТАТОК" Binding="{Binding Quantity}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                                <Button Content="Удалить" Command="{Binding DeleteProductCommand}" Background="#FCA5A5" Foreground="White" BorderThickness="0" Padding="20,10" Margin="0,0,15,0" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="5"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                <Button Content="В Excel" Command="{Binding ExportExcelCommand}" Background="#34D399" Foreground="White" BorderThickness="0" Padding="20,10" Margin="0,0,10,0" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="5"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                <Button Content="В PDF" Command="{Binding ExportPdfCommand}" Background="#F87171" Foreground="White" BorderThickness="0" Padding="20,10" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="5"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ЭКРАН 2: ДАШБОРД -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTab}" Value="1">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Блок тотальных сумм -->
                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{DynamicResource CardBg}" CornerRadius="10" Padding="20" Margin="0,0,10,0" Height="120">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Всего единиц на складе" Foreground="{DynamicResource MutedText}" FontSize="14"/>
                                <TextBlock Text="{Binding TotalProductsCount}" Foreground="{DynamicResource PrimaryText}" FontSize="28" FontWeight="Bold" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="{DynamicResource CardBg}" CornerRadius="10" Padding="20" Margin="10,0,0,0" Height="120">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Общая стоимость товаров" Foreground="{DynamicResource MutedText}" FontSize="14"/>
                                <TextBlock Text="{Binding TotalInventorySum, StringFormat={}{0:F2} ₽}" Foreground="{DynamicResource PrimaryText}" FontSize="28" FontWeight="Bold" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Блок с диаграммой и таблицей дефицита -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="6*"/>
                            <ColumnDefinition Width="4*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Диаграмма -->
                        <Border Grid.Column="0" Background="{DynamicResource CardBg}" CornerRadius="10" Padding="20" Margin="0,0,10,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Товары по категориям" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,15"/>
                                <lvc:PieChart Grid.Row="1" Series="{Binding CategorySeries}" LegendPosition="Right" Margin="10"/>
                            </Grid>
                        </Border>

                        <!-- Критический остаток -->
                        <Border Grid.Column="1" Background="{DynamicResource CardBg}" CornerRadius="10" Padding="20" Margin="10,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="⚠️ Требуют закупки (Остаток &lt; 5)" FontSize="16" FontWeight="SemiBold" Foreground="#EF4444" Margin="0,0,0,15"/>

                                <DataGrid Grid.Row="1" ItemsSource="{Binding LowStockProducts}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" Background="Transparent" BorderThickness="0" RowBackground="Transparent" Foreground="{DynamicResource PrimaryText}" GridLinesVisibility="None" RowHeight="35">
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="{DynamicResource MutedText}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Padding" Value="5,0,0,10"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Товар" Binding="{Binding Name}" Width="*"/>
                                        <DataGridTextColumn Header="Остаток" Binding="{Binding Quantity}" Width="70">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#EF4444"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

            </Grid>
        </Grid>
    </Grid>
</Window>